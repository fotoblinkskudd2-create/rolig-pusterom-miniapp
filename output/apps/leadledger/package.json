{
  "name": "leadledger",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "KundeSpor – Prioriter faktiske kundehenvendelser med en åpen poengmodell.",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json && vite build",
    "start": "node --disable-warning=ExperimentalWarning dist-server/server/index.js",
    "seed": "node --disable-warning=ExperimentalWarning dist-server/server/seed.js",
    "test": "vitest run tests/domain.test.ts tests/api.test.ts",
    "test:e2e": "vitest run tests/e2e.test.ts",
    "test:all": "npm run build && vitest run",
    "cap:sync": "vite build && cap sync ios"
  },
  "dependencies": {
    "@capacitor/core": "8.5.2",
    "@capacitor/ios": "8.5.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "playwright-core": "1.56.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
