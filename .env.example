# REGNViking OS - environment config. Every value below is optional; the
# system runs fully offline with sane defaults if you copy this file as-is.

# Stripe TEST mode secret key for the MVP Factory's checkout stub (sk_test_...).
# Leave empty to keep /api/checkout in stub mode (no real charges possible).
STRIPE_SECRET_KEY=

# Local Ollama model to use if the ollama sidecar (docker-compose --profile ollama) is running.
OLLAMA_MODEL=llama3.1

# Set to 0 to explicitly allow outbound cloud calls in code you add yourself.
# The shipped agents never call the network regardless of this flag.
REGNVIKING_OFFLINE=1
