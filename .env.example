# Kopier til .env og fyll inn. .env skal ALDRI i git.
XAI_API_KEY=
# Hent gjeldende modellnavn fra https://docs.x.ai/docs/models — ikke hardkod i kode.
XAI_MODEL=
# Valgfritt: pris i USD per 1M tokens, for kostnadsestimat i loggen. Tomt = 0.
XAI_PRIS_INN_PER_M=
XAI_PRIS_UT_PER_M=
# Valgfritt
XAI_BASE_URL=https://api.x.ai/v1
XAI_TIMEOUT_S=60
GROKKJERNE_LOGG=logs/kall.jsonl
