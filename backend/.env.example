# Kopier til .env og fyll inn. Ikke sjekk inn .env.
NODE_ENV=development
PORT=8080
LOG_LEVEL=info
DATABASE_URL=postgres://antipsykologen:antipsykologen@localhost:5432/antipsykologen
TRUST_PROXY=false

# Modell: "anthropic" (ekte modell) eller "mock" (merket testmodus, kun lokalt).
MODEL_PROVIDER=anthropic
# Hentes fra https://platform.claude.com/ . Ligger KUN på serveren.
ANTHROPIC_API_KEY=
# La stå tom i produksjon.
ANTHROPIC_BASE_URL=
MODEL_CHAT=claude-opus-5-5
MODEL_CHAT_EFFORT=low
MODEL_CHAT_MAX_TOKENS=8000
MODEL_FALLBACKS=default
MODEL_FAST=claude-haiku-4-5
MODEL_FIRST_TOKEN_TIMEOUT_MS=45000
MODEL_TOTAL_TIMEOUT_MS=120000
MODEL_AUX_TIMEOUT_MS=20000

# USD per million tokens (for kostnadstak). Kontroller mot gjeldende prisliste.
PRICE_CHAT_INPUT_PER_MTOK=4
PRICE_CHAT_OUTPUT_PER_MTOK=20
PRICE_FAST_INPUT_PER_MTOK=1
PRICE_FAST_OUTPUT_PER_MTOK=5

# always | flagged | off
SAFETY_MODEL_CHECK=always

MAX_MESSAGE_CHARS=4000
MAX_IMPORT_CHARS=20000
RATE_LIMIT_MESSAGES_PER_MINUTE=8
DAILY_TOKEN_LIMIT_PER_USER=400000
MONTHLY_COST_LIMIT_USD_PER_USER=5
ANON_SIGNUPS_PER_IP_PER_HOUR=10

CONTEXT_BUDGET_TOKENS=150000
CONTEXT_KEEP_RECENT_MESSAGES=16
EPHEMERAL_TTL_HOURS=24
ACCESS_TOKEN_TTL_MINUTES=60

# Sign in with Apple: appens bundle-ID. Tom = deaktivert.
APPLE_BUNDLE_ID=
